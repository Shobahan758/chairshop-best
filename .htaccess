<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep Laravel's public directory out of browser URLs.
    RewriteCond %{THE_REQUEST} \s/+(?:[^/]+/)*public/ [NC]
    RewriteRule ^public/(.+)$ $1 [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+(?:[^/]+/)*public(?:[/?\s]) [NC]
    RewriteRule ^public/?$ ./ [R=301,L,NE]

    # Let certificate authorities read validation files from the document root.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^\.well-known/(?:acme-challenge|pki-validation)/ - [L]

    # Serve the Laravel application when this project directory is the web root.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
